APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./kanbandoro.db
JWT_SECRET=substitua-por-um-segredo-aleatorio-longo
# A extensão usa chrome-extension://<ID>; liste as origens completas.
CORS_ORIGINS=["http://localhost:5173"]
# Credenciais do cliente OAuth do tipo Aplicativo da Web (NUNCA no bundle da extensão)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EXTENSION_ID=
# Opcional: IDs extras de instalações Chrome/Brave/Edge com redirects cadastrados no mesmo cliente Web.
GOOGLE_EXTENSION_IDS=[]
# Gere com: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GOOGLE_TOKEN_ENCRYPTION_KEY=
