{
  "manifest_version": 3,
  "name": "KanbanDoro",
  "version": "0.2.0",
  "description": "Tarefas e ciclos de foco em um só lugar.",
  "permissions": ["storage", "alarms", "notifications", "scripting", "offscreen", "identity"],
  "host_permissions": ["<all_urls>", "https://api.groq.com/*", "https://gmail.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Abrir KanbanDoro", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
